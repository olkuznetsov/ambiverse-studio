# Leave everything commented out to run in DEMO MODE (no pipeline, no keys).

# Path to the pipeline repo this app drives (its working name was "animembient").
# Setting it switches the studio to real mode; a wrong path fails loudly.
# ANIMEMBIENT_DIR=~/path/to/animembient

# Interpreter for pipeline jobs (default: $ANIMEMBIENT_DIR/venv/bin/python)
# PIPELINE_PYTHON=

# Where raw Veo exports land ("Untitled video*.mp4")
# DOWNLOADS_DIR=~/Downloads

# Force demo mode even when ANIMEMBIENT_DIR is set
# STUDIO_DEMO=1

# API port (the Vite dev proxy targets 4700)
# PORT=4700
